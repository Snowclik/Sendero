{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sendero",
  "version": "1.0.0",
  "identifier": "com.hack4edu.sendero",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:8742",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sendero",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob: ipc: http://ipc.localhost; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
