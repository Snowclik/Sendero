---
import { GameApp } from '../components/GameApp';
---

<!doctype html>
<html lang="es" class="w-full h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Sendero</title>
    <meta
      name="description"
      content="Videojuego educativo 100% offline de Matemáticas y Lectura para niños de 8 a 10 años con TDAH."
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23f59e0b'><circle cx='12' cy='12' r='5'/><path d='M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42' stroke='%23f59e0b' stroke-width='2' stroke-linecap='round'/></svg>"
    />
    <style is:global>
      :root {
        color-scheme: light;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background-color: #e0f2fe;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow: hidden;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .animate-fadeIn {
        animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      /* ===== Estilo "cozy game": paneles crema con relieve, casillas de inventario ===== */
      .cozy-panel {
        background: #fffaf0;
        border: 3px solid #ffffff;
        border-radius: 28px;
        box-shadow: 0 8px 0 rgba(146, 112, 52, 0.14), 0 18px 40px rgba(80, 55, 15, 0.18);
      }
      .cozy-inset {
        background: #f6ecd6;
        border-radius: 22px;
        box-shadow: inset 0 3px 0 rgba(146, 112, 52, 0.1);
      }
      .cozy-tile {
        background: #ffffff;
        border: 3px solid #f1e4c6;
        border-radius: 18px;
        box-shadow: 0 4px 0 #e6d3ab;
        transition: transform 0.12s, box-shadow 0.12s, background 0.15s, border-color 0.15s;
      }
      button.cozy-tile:hover { background: #fffdf6; }
      button.cozy-tile:active { transform: translateY(3px); box-shadow: 0 1px 0 #e6d3ab; }
      .cozy-tile.is-on { background: #e0f2fe; border-color: #7dd3fc; box-shadow: 0 4px 0 #38bdf8; }
      .cozy-tile.is-ok { background: #dcfce7; border-color: #86efac; box-shadow: 0 4px 0 #22c55e; }
      .cozy-tile.is-soft { background: #fff1f2; border-color: #fecdd3; box-shadow: 0 4px 0 #fda4af; }
      .cozy-ribbon {
        display: inline-block;
        background: #2a9d8f;
        color: #fff;
        font-weight: 800;
        padding: 8px 30px;
        clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 50%, 100% 100%, 0 100%, 14px 50%);
        box-shadow: inset 0 -4px 0 rgba(0, 0, 0, 0.12);
      }
      .paper {
        background: repeating-linear-gradient(#fffdf7 0 27px, #f3e9d2 27px 28px);
        border-radius: 14px;
        box-shadow: 0 3px 0 #e6d3ab, 0 8px 16px rgba(80, 55, 15, 0.08);
      }
      @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
      @keyframes hop { 0%, 100% { transform: translateY(0); } 30% { transform: translateY(-14px); } 60% { transform: translateY(0); } 75% { transform: translateY(-5px); } }
      @keyframes wiggle { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-6deg); } 75% { transform: rotate(6deg); } }
      .anim-bob { animation: bob 2.6s ease-in-out infinite; }
      .anim-hop { animation: hop 0.7s ease-out; }
      .anim-wiggle { animation: wiggle 0.5s ease-in-out 2; }

      /* Modo calma (check-in "inquieto") y preferencia del sistema: sin animaciones */
      .calm *:not(.keep-motion) {
        animation: none !important;
        transition-duration: 0ms !important;
      }
      @media (prefers-reduced-motion: reduce) {
        *:not(.keep-motion) {
          animation: none !important;
          transition-duration: 0ms !important;
        }
      }

      @media print {
        body * {
          visibility: hidden !important;
        }
        .print-sheet,
        .print-sheet * {
          visibility: visible !important;
        }
        .print-sheet {
          position: fixed !important;
          left: 0;
          top: 0;
          width: 100% !important;
          box-shadow: none !important;
          border: none !important;
        }
        html, body {
          background: white !important;
          overflow: visible !important;
        }
      }
    </style>
  </head>
  <body class="w-full h-full">
    <GameApp client:load />
  </body>
</html>
